EXIT_CODE: 0
# Odsadenie blokov pomocou medzier (INDENT pri zväčšení odsadenia, DEDENT pri návrate):
KW_DEF ID(foo) LPAREN ID(x) COLON KW_INT RPAREN COLON KW_INT ASSIGN EOL
INDENT
KW_VAR ID(res) ASSIGN ID(x) EOL
KW_IF ID(res) GT INT(0) KW_THEN EOL
INDENT
ID(res) ASSIGN ID(res) PLUS INT(1) EOL
DEDENT
KW_ELSE EOL
INDENT
ID(res) ASSIGN INT(0) EOL
DEDENT
ID(res) EOL
DEDENT
EOF
