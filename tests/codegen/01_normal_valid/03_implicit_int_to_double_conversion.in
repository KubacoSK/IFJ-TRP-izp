import ifj26.*

def addDouble(x: Double, y: Double): Double =
  x + y

def returnIntAsDouble(n: Int): Double =
  return n

@main def run(): Unit =
  // 1. Int + Double a Double + Int
  val r1 = 5 + 2.5
  val r2 = 2.5 + 5
  // 2. Int / Double a Double / Int (musi pouzit DIV po INT2FLOAT, nie IDIV!)
  val r3 = 7 / 2.0
  val r4 = 7.0 / 2
  // 3. Inicializacia a priradenie Int do premennej typu Double
  var d: Double = 10
  d = 20
  // 4. Odovzdanie Int argumentov do Double parametrov a navrat Int z Double funkcie
  val r5 = addDouble(3, 4.5)
  val r6 = returnIntAsDouble(9)
  // 5. Porovnanie Int a Double v podmienke
  if 5 == 5.0 then
    if 3 < 3.5 then
      val s1 = toStr(r1)
      val s2 = toStr(r3)
      val s3 = toStr(d)
      val s4 = toStr(r5)
      val s5 = toStr(r6)
      val out = s1 + " " + s2 + " " + s3 + " " + s4 + " " + s5 + "\n"
      print(out)
    else
      ()
  else
    ()
